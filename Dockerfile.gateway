FROM rust:1.97.1-bookworm AS builder

WORKDIR /src
COPY . .
RUN cargo build --locked --release -p qx-gateway

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /src/target/release/qx-gateway /usr/local/bin/qx-gateway

USER 10001
ENV PORT=8080
EXPOSE 8080

CMD ["sh", "-c", "exec qx-gateway serve --listen 0.0.0.0:${PORT:-8080} --dodil-bucket \"${QX_DODIL_BUCKET:?QX_DODIL_BUCKET is required}\" --program \"${QX_PROGRAM_ID:?QX_PROGRAM_ID is required}\" --rpc-url \"${QX_RPC_URL:-https://api.devnet.solana.com}\""]
