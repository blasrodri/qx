+void llama_context::qx_trace_capture(ggml_cgraph * gf) {
+    const char * path = std::getenv("QX_TRACE_PATH");
+    if (!path || !*path) {
+        return;
+    }
+    if (std::getenv("QX_TRACE_ONCE") != nullptr && qx_trace_captured) {
+        return;
+    }
+
+    if (!qx_trace) {
+        qx_trace = std::make_unique<qx_trace_writer>(path, static_cast<uint32_t>(model.hparams.n_embd));
+    }
+    if (!qx_trace->good()) {
+        return;
+    }
+
+    std::map<int, ggml_tensor *> inputs;
+    std::map<int, ggml_tensor *> topk;
+    std::map<int, ggml_tensor *> weights;
+
+    for (int i = 0; i < gf->n_nodes; ++i) {
+        ggml_tensor * tensor = gf->nodes[i];
+        const char * name = ggml_get_name(tensor);
+        int layer = -1;
+        if (qx_match_layer_name(name, "ffn_moe_input", layer)) {
+            inputs[layer] = tensor;
+        } else if (qx_match_layer_name(name, "ffn_moe_topk", layer)) {
+            topk[layer] = tensor;
+        } else if (qx_match_layer_name(name, "ffn_moe_weights_norm", layer)) {
+            weights[layer] = tensor;
+        }
+    }
+
+    for (const auto & [layer, input_tensor] : inputs) {
+        const auto topk_it = topk.find(layer);
+        const auto weights_it = weights.find(layer);
+        if (topk_it == topk.end() || weights_it == weights.end()) {
+            continue;
+        }
+
+        std::vector<float> input_values;
+        std::vector<int32_t> topk_values;
+        std::vector<float> weight_values;
+        if (!qx_read_tensor_f32(input_tensor, input_values) ||
+                !qx_read_tensor_i32(topk_it->second, topk_values) ||
+                !qx_read_tensor_f32(weights_it->second, weight_values)) {
+            LLAMA_LOG_WARN("QX trace: unsupported tensor type at layer %d\n", layer);
+            continue;
+        }
+
+        const int64_t hidden = input_tensor->ne[0];
+        const int64_t n_tokens = input_tensor->ne[1];
+        const int64_t n_selected = topk_it->second->ne[0];
+        const int64_t weight_stride = weights_it->second->ne[0];
+        if (hidden != model.hparams.n_embd || n_selected <= 0 ||
+                input_values.size() < static_cast<size_t>(hidden * n_tokens) ||
+                topk_values.size() < static_cast<size_t>(n_selected * n_tokens) ||
+                weight_values.size() < static_cast<size_t>(weight_stride * n_tokens)) {
+            LLAMA_LOG_WARN("QX trace: unexpected MoE shape at layer %d\n", layer);
+            continue;
+        }
+
+        for (int64_t token = 0; token < n_tokens; ++token) {
+            const float * hidden_state = input_values.data() + token * hidden;
+            for (int64_t slot = 0; slot < n_selected; ++slot) {
+                const int32_t expert = topk_values[token * n_selected + slot];
+                const size_t weight_index = static_cast<size_t>(token * weight_stride + slot);
+                if (expert < 0 || expert > 255 || weight_index >= weight_values.size()) {
+                    continue;
+                }
+                qx_trace->append(static_cast<uint16_t>(layer), static_cast<uint8_t>(expert),
+                        weight_values[weight_index], static_cast<uint16_t>(token), hidden_state,
+                        static_cast<size_t>(hidden));
+            }
+        }
+    }
+    qx_trace_captured = true;
+}
