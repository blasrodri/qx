+static void ggml_metal_profile_moe_ops(ggml_metal_t ctx) {
+    const char * enabled = getenv("GGML_METAL_PROFILE_MOE");
+    const bool active = enabled && atoi(enabled) != 0;
+    if (!active || !ctx->gf) {
+        return;
+    }
+
+    // The normal graph must finish first: the replayed MUL_MAT_ID nodes read
+    // activations and GPU-produced expert IDs from the completed decode.
+    for (int i = 0; i <= ctx->n_cb; ++i) {
+        if (ctx->cmd_bufs[i].obj) {
+            [ctx->cmd_bufs[i].obj waitUntilCompleted];
+        }
+    }
+
+    id<MTLCommandQueue> queue = ggml_metal_device_get_queue(ctx->dev);
+    double gate_up_us = 0.0;
+    double down_us = 0.0;
+    double other_us = 0.0;
+    double moe_block_us = 0.0;
+    int gate_up_count = 0;
+    int down_count = 0;
+    int mul_mat_id_nodes = 0;
+    int moe_block_nodes = 0;
+
+    for (int node_index = 0; node_index < ctx->gf->n_nodes; ++node_index) {
+        struct ggml_tensor * node = ctx->gf->nodes[node_index];
+        const bool is_mul_mat_id = node && node->op == GGML_OP_MUL_MAT_ID && node->src[0];
+        const bool is_moe_node = node && strncmp(node->name, "ffn_moe_", 8) == 0;
+        if (!is_mul_mat_id && !is_moe_node) {
+            continue;
+        }
+        if (is_mul_mat_id) {
+            mul_mat_id_nodes++;
+        }
+        if (getenv("GGML_METAL_PROFILE_MOE_VERBOSE")) {
+            fprintf(stderr,
+                "MOE_PROFILE node=%d name=%s op=%s input=%lld next=%s next2=%s\n",
+                node_index,
+                node->name,
+                ggml_op_name(node->op),
+                (long long) node->src[0]->ne[0],
+                node_index + 1 < ctx->gf->n_nodes ? ggml_op_name(ctx->gf->nodes[node_index + 1]->op) : "none",
+                node_index + 2 < ctx->gf->n_nodes ? ggml_op_name(ctx->gf->nodes[node_index + 2]->op) : "none");
+        }
+
+        // Granite's active expert matrices are [1024, 1024] gate/up and
+        // [512, 1024] down in ggml's column-major tensor convention.
+        const int64_t input_width = is_mul_mat_id ? node->src[0]->ne[0] : 0;
+        const char * label = input_width == 1024 ? "gate/up" :
+                             input_width == 512  ? "down" : "other";
+        id<MTLCommandBuffer> command_buffer = [queue commandBufferWithUnretainedReferences];
+        [command_buffer enqueue];
+        ggml_metal_op_t op = ggml_metal_op_init(
+            ctx->dev,
+            (ggml_metal_cmd_buf_t) command_buffer,
+            ctx->gf,
+            node_index,
+            node_index + 1,
+            false,
+            false,
+            false,
+            0,
+            0);
+        if (ggml_metal_op_n_nodes(op) != 1 || ggml_metal_op_encode(op, 0) == 0) {
+            ggml_metal_op_free(op);
+            [command_buffer commit];
+            [command_buffer waitUntilCompleted];
+            continue;
+        }
+        ggml_metal_op_free(op);
+        [command_buffer commit];
+        [command_buffer waitUntilCompleted];
+
+        const double gpu_us = (command_buffer.GPUEndTime - command_buffer.GPUStartTime) * 1.0e6;
+        if (is_moe_node) {
+            moe_block_us += gpu_us;
+            moe_block_nodes++;
+        }
+        if (is_mul_mat_id) {
+            if (strcmp(label, "gate/up") == 0) {
+                gate_up_us += gpu_us;
+                gate_up_count++;
+            } else if (strcmp(label, "down") == 0) {
+                down_us += gpu_us;
+                down_count++;
+            } else {
+                other_us += gpu_us;
+            }
+        }
+    }
+
+    const double gate_up_avg = gate_up_count ? gate_up_us / gate_up_count : 0.0;
+    const double down_avg = down_count ? down_us / down_count : 0.0;
+    const double matrix_total = gate_up_us + down_us + other_us;
+    fprintf(stderr, "MOE_PROFILE matched_mul_mat_id=%d moe_nodes=%d\n", mul_mat_id_nodes, moe_block_nodes);
+    fprintf(stderr,
+        "MOE_PROFILE gate/up=%.2f us (%d) down=%.2f us (%d) "
+        "matrix_total=%.2f us full_moe_nodes=%.2f us\n",
+        gate_up_avg,
+        gate_up_count,
+        down_avg,
+        down_count,
+        matrix_total,
+        moe_block_us);
+}
