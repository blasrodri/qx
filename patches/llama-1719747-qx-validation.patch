+            "GRAPH_PROFILE node=%d name=%s op=%s dst=%lldx%lld src0=%lldx%lld src1=%lldx%lld\n",
+            node_index,
+            node->name,
+            ggml_op_name(node->op),
+            (long long) node->ne[0],
+            (long long) node->ne[1],
+            node->src[0] ? (long long) node->src[0]->ne[0] : 0,
+            node->src[0] ? (long long) node->src[0]->ne[1] : 0,
+            node->src[1] ? (long long) node->src[1]->ne[0] : 0,
+            node->src[1] ? (long long) node->src[1]->ne[1] : 0);
+    }
+}
+
+// Replay the fixed-shape decode primitives on the completed graph so their
+// GPU timestamps can be compared with QX's isolated per-layer measurements.
+// This is intentionally opt-in: replaying nodes adds synchronization and is
+// never part of the normal llama.cpp execution path.
+static void ggml_metal_profile_decode_ops(ggml_metal_t ctx) {
+    const char * enabled = getenv("GGML_METAL_PROFILE_DECODE");
+    if (!enabled || atoi(enabled) == 0 || !ctx->gf) {
+        return;
+    }
+
+    bool is_decode_graph = false;
+    for (int node_index = 0; node_index < ctx->gf->n_nodes; ++node_index) {
+        struct ggml_tensor * node = ctx->gf->nodes[node_index];
+        if (node && node->op == GGML_OP_FLASH_ATTN_EXT && node->src[0] && node->src[1]
+            && node->src[0]->ne[1] == 1 && node->src[1]->ne[1] >= 256) {
+            is_decode_graph = true;
+            break;
+        }
+    }
+    if (!is_decode_graph) {
+        return;
+    }
+
+    for (int i = 0; i <= ctx->n_cb; ++i) {
+        if (ctx->cmd_bufs[i].obj) {
+            [ctx->cmd_bufs[i].obj waitUntilCompleted];
+        }
+    }
+
+    id<MTLCommandQueue> queue = ggml_metal_device_get_queue(ctx->dev);
+    double qkv_us = 0.0;
+    double rope_kv_us = 0.0;
+    double attention_us = 0.0;
+    double o_us = 0.0;
+    int qkv_count = 0;
+    int rope_kv_count = 0;
+    int attention_count = 0;
+    int o_count = 0;
+    int layer_starts[24];
+    for (int layer = 0; layer < 24; ++layer) {
+        layer_starts[layer] = -1;
+    }
+
+    for (int node_index = 0; node_index < ctx->gf->n_nodes; ++node_index) {
+        struct ggml_tensor * node = ctx->gf->nodes[node_index];
+        if (!node) {
+            continue;
+        }
+        int norm_layer = -1;
+        if (sscanf(node->name, "norm-%d", &norm_layer) == 1
+            && norm_layer >= 0 && norm_layer < 24 && layer_starts[norm_layer] < 0) {
+            layer_starts[norm_layer] = node_index;
+        }
+        const bool qkv = node->op == GGML_OP_MUL_MAT
+            && (strncmp(node->name, "Qcur-", 5) == 0
+                || strncmp(node->name, "Kcur-", 5) == 0
+                || strncmp(node->name, "Vcur-", 5) == 0);
+        const bool rope = node->op == GGML_OP_ROPE;
+        const bool kv_write = node->op == GGML_OP_SET_ROWS
+            && (strncmp(node->name, "cache_k_", 8) == 0
+                || strncmp(node->name, "cache_v_", 8) == 0);
+        const bool attention = node->op == GGML_OP_FLASH_ATTN_EXT;
+        const bool output = node->op == GGML_OP_MUL_MAT
+            && strncmp(node->name, "attn_out-", 9) == 0;
+        if (!qkv && !rope && !kv_write && !attention && !output) {
+            continue;
+        }
+
+        id<MTLCommandBuffer> command_buffer = [queue commandBufferWithUnretainedReferences];
+        [command_buffer enqueue];
+        ggml_metal_op_t op = ggml_metal_op_init(
+            ctx->dev,
+            (ggml_metal_cmd_buf_t) command_buffer,
+            ctx->gf,
+            node_index,
+            node_index + 1,
+            false,
+            false,
+            false,
+            0,
+            0);
+        if (ggml_metal_op_n_nodes(op) != 1 || ggml_metal_op_encode(op, 0) == 0) {
+            ggml_metal_op_free(op);
+            [command_buffer commit];
+            [command_buffer waitUntilCompleted];
+            continue;
+        }
+        ggml_metal_op_free(op);
+        [command_buffer commit];
+        [command_buffer waitUntilCompleted];
+        const double gpu_us = (command_buffer.GPUEndTime - command_buffer.GPUStartTime) * 1.0e6;
+        if (qkv) {
+            qkv_us += gpu_us;
+            qkv_count++;
+        } else if (rope || kv_write) {
+            rope_kv_us += gpu_us;
+            rope_kv_count++;
+        } else if (attention) {
+            attention_us += gpu_us;
+            attention_count++;
+        } else if (output) {
+            o_us += gpu_us;
+            o_count++;
+        }
+    }
+
+    // Replay each complete transformer layer as one command buffer. This is
+    // a diagnostic whole-block timing, not the normal llama.cpp submission
+    // topology; it provides the missing composition reference for QX's layer
+    // total without pretending isolated node sums are additive.
+    double block_us = 0.0;
+    int block_count = 0;
+    for (int layer = 0; layer < 24; ++layer) {
+        if (layer_starts[layer] < 0) {
+            continue;
+        }
+        int end = ctx->gf->n_nodes;
+        if (layer < 23 && layer_starts[layer + 1] >= 0) {
+            end = layer_starts[layer + 1];
+        } else if (layer == 23) {
+            for (int node_index = layer_starts[layer] + 1;
+                 node_index < ctx->gf->n_nodes;
+                 ++node_index) {
+                struct ggml_tensor * node = ctx->gf->nodes[node_index];
+                if (node && node->op == GGML_OP_RMS_NORM
+                    && strncmp(node->name, "norm-", 5) != 0) {
+                    end = node_index;
+                    break;
+                }
+            }
+        }
+        if (end <= layer_starts[layer]) {
+            continue;
+        }
+        id<MTLCommandBuffer> command_buffer = [queue commandBufferWithUnretainedReferences];
+        [command_buffer enqueue];
+        ggml_metal_op_t op = ggml_metal_op_init(
+            ctx->dev,
+            (ggml_metal_cmd_buf_t) command_buffer,
+            ctx->gf,
+            layer_starts[layer],
+            end,
+            false,
+            false,
+            false,
+            0,
+            0);
+        const int n_nodes = ggml_metal_op_n_nodes(op);
+        bool encoded = n_nodes > 0;
+        for (int node = 0; encoded && node < n_nodes; ++node) {
+            encoded = ggml_metal_op_encode(op, node) != 0;
+        }
+        ggml_metal_op_free(op);
+        if (!encoded) {
+            [command_buffer commit];
+            [command_buffer waitUntilCompleted];
+            continue;
+        }
+        [command_buffer commit];
+        [command_buffer waitUntilCompleted];
+        block_us += (command_buffer.GPUEndTime - command_buffer.GPUStartTime) * 1.0e6;
+        block_count++;
+    }
+
+    fprintf(stderr,
+        "DECODE_PROFILE qkv=%.2f us (%d, %.2f/layer) "
+        "rope_kv=%.2f us (%d, %.2f/layer) "
+        "attention=%.2f us (%d, %.2f/layer) "
+        "o=%.2f us (%d, %.2f/layer) core=%.2f us "
+        "block=%.2f us (%d, %.2f/layer)\n",
+        qkv_us, qkv_count, qkv_us / 24.0,
+        rope_kv_us, rope_kv_count, rope_kv_us / 24.0,
+        attention_us, attention_count, attention_us / 24.0,
+        o_us, o_count, o_us / 24.0,
+        qkv_us + rope_kv_us + attention_us + o_us,
+        block_us, block_count, block_us / (block_count ? block_count : 1));
+}
