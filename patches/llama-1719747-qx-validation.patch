 #include "llama.h"
+#include <algorithm>
+#include <cmath>
 #include <clocale>
+#include <cstdint>
 #include <cstdio>
 #include <cstring>
+#include <cstdlib>
+#include <fstream>
 #include <string>
+#include <sys/resource.h>
 #include <vector>
 
+struct qx_quality_block {
+    uint64_t start_position;
+    uint32_t positions;
+    double nll_sum;
+};
+
+struct qx_quality_sample {
+    uint64_t position;
+    uint32_t target;
+    double nll;
+    std::vector<float> logits;
+};
+
+template <typename T>
+static bool qx_read(std::ifstream & file, T & value) {
+    return static_cast<bool>(file.read(reinterpret_cast<char *>(&value), sizeof(value)));
+}
+
+static bool qx_skip_string(std::ifstream & file) {
+    uint32_t size = 0;
+    if (!qx_read(file, size)) {
+        return false;
+    }
+    file.seekg(size, std::ios::cur);
+    return static_cast<bool>(file);
+}
+
+static bool qx_read_quality_tokens(const char * path, std::vector<llama_token> & tokens) {
+    std::ifstream file(path, std::ios::binary);
+    char magic[8] = {};
+    uint32_t version = 0;
+    uint64_t count = 0;
+    if (!file.read(magic, sizeof(magic)) || std::memcmp(magic, "QXTOKN\0\0", 8) != 0 ||
+            !qx_read(file, version) || version != 1 || !qx_skip_string(file) ||
+            !qx_skip_string(file) || !qx_skip_string(file) || !qx_skip_string(file) ||
+            !qx_read(file, count)) {
+        return false;
+    }
+    tokens.resize(static_cast<size_t>(count));
+    for (auto & token : tokens) {
+        uint32_t value = 0;
+        if (!qx_read(file, value)) {
+            return false;
+        }
+        token = static_cast<llama_token>(value);
+    }
+    return tokens.size() >= 2 && file.peek() == std::ifstream::traits_type::eof();
+}
+
+template <typename T>
+static void qx_write(std::ofstream & file, const T & value) {
+    file.write(reinterpret_cast<const char *>(&value), sizeof(value));
+}
+
+static double qx_token_nll(const float * logits, int32_t vocab, llama_token target) {
+    float maximum = logits[0];
+    for (int32_t index = 1; index < vocab; ++index) {
+        maximum = std::max(maximum, logits[index]);
+    }
+    double sum = 0.0;
+    for (int32_t index = 0; index < vocab; ++index) {
+        sum += std::exp(static_cast<double>(logits[index] - maximum));
+    }
+    return std::log(sum) + maximum - logits[target];
+}
+
+static int qx_run_quality(
+        llama_context * ctx,
+        const llama_vocab * vocab,
+        const char * token_path,
+        const char * trace_path,
+        uint32_t block_tokens,
+        uint32_t sample_stride) {
+    std::vector<llama_token> tokens;
+    if (!qx_read_quality_tokens(token_path, tokens) || sample_stride == 0 || block_tokens < 2) {
+        fprintf(stderr, "invalid QX quality corpus or settings\n");
+        return 1;
+    }
+    const int32_t vocab_size = llama_vocab_n_tokens(vocab);
+    std::vector<qx_quality_block> blocks;
+    std::vector<qx_quality_sample> samples;
+    size_t start = 0;
+    while (start + 1 < tokens.size()) {
+        const size_t end = std::min(start + block_tokens, tokens.size());
+        llama_memory_clear(llama_get_memory(ctx), true);
+        qx_quality_block block {
+            static_cast<uint64_t>(start),
+            static_cast<uint32_t>(end - start - 1),
+            0.0,
+        };
+        for (size_t local = 0; local + 1 < end - start; ++local) {
+            llama_token input = tokens[start + local];
+            llama_batch batch = llama_batch_get_one(&input, 1);
+            if (llama_decode(ctx, batch) != 0) {
+                fprintf(stderr, "llama quality decode failed at position %zu\n", start + local);
+                return 1;
+            }
+            const float * logits = llama_get_logits(ctx);
+            const llama_token target = tokens[start + local + 1];
+            if (logits == nullptr || target < 0 || target >= vocab_size) {
+                fprintf(stderr, "invalid llama quality logits or target\n");
+                return 1;
+            }
+            const double nll = qx_token_nll(logits, vocab_size, target);
+            block.nll_sum += nll;
+            const size_t position = start + local;
+            if (position % sample_stride == 0) {
+                qx_quality_sample sample;
+                sample.position = static_cast<uint64_t>(position);
+                sample.target = static_cast<uint32_t>(target);
+                sample.nll = nll;
+                sample.logits.assign(logits, logits + vocab_size);
+                samples.push_back(std::move(sample));
+            }
+        }
+        blocks.push_back(block);
+        if (end == tokens.size()) {
+            break;
+        }
+        start = end - 1;
+    }
+    std::ofstream file(trace_path, std::ios::binary | std::ios::trunc);
+    const char magic[8] = {'Q', 'X', 'Q', 'U', 'A', 'L', '\0', '\0'};
+    const uint32_t version = 1;
+    const uint64_t positions = tokens.size() - 1;
+    const uint32_t block_count = static_cast<uint32_t>(blocks.size());
+    const uint32_t sample_count = static_cast<uint32_t>(samples.size());
+    file.write(magic, sizeof(magic));
+    qx_write(file, version);
+    qx_write(file, static_cast<uint32_t>(vocab_size));
+    qx_write(file, positions);
+    qx_write(file, block_tokens);
+    qx_write(file, sample_stride);
+    qx_write(file, block_count);
+    qx_write(file, sample_count);
+    for (const auto & block : blocks) {
+        qx_write(file, block.start_position);
+        qx_write(file, block.positions);
+        qx_write(file, block.nll_sum);
+    }
+    for (const auto & sample : samples) {
+        qx_write(file, sample.position);
+        qx_write(file, sample.target);
+        qx_write(file, sample.nll);
+        file.write(reinterpret_cast<const char *>(sample.logits.data()),
+                static_cast<std::streamsize>(sample.logits.size() * sizeof(float)));
+    }
+    if (!file) {
+        fprintf(stderr, "failed to write QX quality trace %s\n", trace_path);
+        return 1;
+    }
+    double nll_sum = 0.0;
+    for (const auto & block : blocks) {
+        nll_sum += block.nll_sum;
+    }
+    const double nll = nll_sum / positions;
+    fprintf(stderr,
+            "QX quality trace: %llu positions, NLL %.6f, PPL %.6f, %u samples -> %s\n",
+            static_cast<unsigned long long>(positions), nll, std::exp(nll), sample_count, trace_path);
+    return 0;
+}
