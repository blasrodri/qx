+// Minimal bridge format shared with qx-compiler::QxTrace. This is deliberately
+// local to the calibration build: it does not change llama.cpp's public API.
+struct qx_trace_writer {
+    std::ofstream file;
+    uint64_t records = 0;
+
+    qx_trace_writer(const char * path, uint32_t hidden_size) :
+        file(path, std::ios::binary | std::ios::trunc) {
+        if (!file) {
+            LLAMA_LOG_ERROR("QX trace: failed to open %s\n", path);
+            return;
+        }
+        const char magic[8] = {'Q', 'X', 'T', 'R', 'A', 'C', 'E', '\0'};
+        file.write(magic, sizeof(magic));
+        write_u32(2);
+        write_u32(hidden_size);
+        write_u64(0); // patched by the destructor
+    }
+
+    ~qx_trace_writer() {
+        if (!file) {
+            return;
+        }
+        file.flush();
+        file.seekp(16, std::ios::beg);
+        write_u64(records);
+        file.flush();
+    }
+
+    bool good() const {
+        return file.good();
+    }
+
+    void append(uint16_t layer, uint8_t expert, float router_weight, uint16_t token,
+            const float * hidden, size_t hidden_size) {
+        write_u16(layer);
+        file.put(static_cast<char>(expert));
+        file.put(0);
+        write_f32(router_weight);
+        write_u16(token);
+        for (size_t i = 0; i < hidden_size; ++i) {
+            write_f32(hidden[i]);
+        }
+        ++records;
+    }
+
+private:
+    void write_u16(uint16_t value) {
+        const uint8_t bytes[] = {
+            static_cast<uint8_t>(value),
+            static_cast<uint8_t>(value >> 8),
+        };
+        file.write(reinterpret_cast<const char *>(bytes), sizeof(bytes));
+    }
+
+    void write_u32(uint32_t value) {
+        const uint8_t bytes[] = {
+            static_cast<uint8_t>(value),
+            static_cast<uint8_t>(value >> 8),
+            static_cast<uint8_t>(value >> 16),
+            static_cast<uint8_t>(value >> 24),
+        };
+        file.write(reinterpret_cast<const char *>(bytes), sizeof(bytes));
+    }
+
+    void write_u64(uint64_t value) {
+        const uint8_t bytes[] = {
+            static_cast<uint8_t>(value),
+            static_cast<uint8_t>(value >> 8),
+            static_cast<uint8_t>(value >> 16),
+            static_cast<uint8_t>(value >> 24),
+            static_cast<uint8_t>(value >> 32),
+            static_cast<uint8_t>(value >> 40),
+            static_cast<uint8_t>(value >> 48),
+            static_cast<uint8_t>(value >> 56),
+        };
+        file.write(reinterpret_cast<const char *>(bytes), sizeof(bytes));
+    }
+
+    void write_f32(float value) {
+        uint32_t bits = 0;
+        std::memcpy(&bits, &value, sizeof(bits));
+        write_u32(bits);
+    }
+};
+
+static bool qx_read_tensor_f32(const ggml_tensor * tensor, std::vector<float> & values) {
+    if (!tensor || (tensor->type != GGML_TYPE_F32 && tensor->type != GGML_TYPE_F16 && tensor->type != GGML_TYPE_BF16)) {
+        return false;
+    }
+
+    std::vector<uint8_t> raw(ggml_nbytes(tensor));
+    ggml_backend_tensor_get(tensor, raw.data(), 0, raw.size());
+    values.resize(static_cast<size_t>(ggml_nelements(tensor)));
+
+    size_t index = 0;
+    for (int64_t i3 = 0; i3 < tensor->ne[3]; ++i3) {
+        for (int64_t i2 = 0; i2 < tensor->ne[2]; ++i2) {
+            for (int64_t i1 = 0; i1 < tensor->ne[1]; ++i1) {
+                for (int64_t i0 = 0; i0 < tensor->ne[0]; ++i0, ++index) {
+                    const uint8_t * ptr = raw.data() + i3 * tensor->nb[3] + i2 * tensor->nb[2] + i1 * tensor->nb[1] + i0 * tensor->nb[0];
+                    if (tensor->type == GGML_TYPE_F32) {
+                        std::memcpy(&values[index], ptr, sizeof(float));
+                    } else if (tensor->type == GGML_TYPE_F16) {
+                        ggml_fp16_t value;
+                        std::memcpy(&value, ptr, sizeof(value));
+                        values[index] = ggml_fp16_to_fp32(value);
+                    } else {
+                        ggml_bf16_t value;
+                        std::memcpy(&value, ptr, sizeof(value));
+                        values[index] = ggml_bf16_to_fp32(value);
+                    }
+                }
+            }
+        }
+    }
+    return true;
+}
+
+static bool qx_read_tensor_i32(const ggml_tensor * tensor, std::vector<int32_t> & values) {
+    if (!tensor || tensor->type != GGML_TYPE_I32) {
+        return false;
+    }
+
+    std::vector<uint8_t> raw(ggml_nbytes(tensor));
+    ggml_backend_tensor_get(tensor, raw.data(), 0, raw.size());
+    values.resize(static_cast<size_t>(ggml_nelements(tensor)));
+
+    size_t index = 0;
+    for (int64_t i3 = 0; i3 < tensor->ne[3]; ++i3) {
+        for (int64_t i2 = 0; i2 < tensor->ne[2]; ++i2) {
+            for (int64_t i1 = 0; i1 < tensor->ne[1]; ++i1) {
+                for (int64_t i0 = 0; i0 < tensor->ne[0]; ++i0, ++index) {
+                    const uint8_t * ptr = raw.data() + i3 * tensor->nb[3] + i2 * tensor->nb[2] + i1 * tensor->nb[1] + i0 * tensor->nb[0];
+                    std::memcpy(&values[index], ptr, sizeof(int32_t));
+                }
+            }
+        }
+    }
+    return true;
+}
+
+static bool qx_match_layer_name(const char * name, const char * prefix, int & layer) {
+    const std::string format = std::string(prefix) + "-%d%n";
+    int consumed = -1;
+    if (std::sscanf(name, format.c_str(), &layer, &consumed) != 1 || consumed < 0) {
+        return false;
+    }
+    return name[consumed] == '\0';
+}
